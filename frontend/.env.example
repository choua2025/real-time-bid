# Frontend runtime config (see nuxt.config.ts). Copy to .env for local dev.
# In production these are set in the Vercel project's Environment Variables and
# must point at the Render backend URL.

# Local dev defaults:
NUXT_PUBLIC_API_BASE="http://localhost:3000/api"
NUXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Production example (replace with your real Render service URL):
# NUXT_PUBLIC_API_BASE="https://realtime-bid-api.onrender.com/api"
# NUXT_PUBLIC_SOCKET_URL="https://realtime-bid-api.onrender.com"
